// Place your key bindings in this file to override the defaults
[
// navigate tabs    
{
    "key": "ctrl+alt+left",
    "command": "workbench.action.previousEditor",
    "when": ""
},
{
    "key": "ctrl+alt+right",
    "command": "workbench.action.nextEditor",
    "when": ""
},
// "navigate tabs" - disabled presets
{
    "key": "ctrl+pagedown",
    "command": "-workbench.action.nextEditor"
},
{
    "key": "ctrl+pageup",
    "command": "-workbench.action.previousEditor"
},
// "toggle explorer" - mixed
{
    "key": "ctrl+alt+f",
    "command": "-workbench.view.search",
    "when": "workbench.view.search.active && neverMatch =~ /doesNotMatch/"
},
{
    "key": "ctrl+alt+f",
    "command": "-workbench.action.findInFiles"
},
{
    "key": "-ctrl+shift+f",
    "command": "-workbench.view.search",
    "when": "workbench.view.search.active && neverMatch =~ /doesNotMatch/"
},
{
    "key": "-ctrl+shift+f",
    "command": "-workbench.action.findInFiles"
},
{
    "key": "ctrl+alt+f",
    "command": "workbench.view.search",
    "when": ""
},
{
    "key": "ctrl+alt+f",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "activeViewlet == 'workbench.view.search' && sideBarVisible"
},
// "save all" - disabled presets
{
    "key": "ctrl+k s",
    "command": "-saveAll"
},
// "save all"
{
    "key": "ctrl+alt+s",
    "command": "saveAll"
},
// "jump page" - disabled presets
{
    "key": "pageup",
    "command": "-cursorPageUp",
    "when": "textInputFocus"
},
{
    "key": "alt+pageup",
    "command": "-scrollPageUp",
    "when": "textInputFocus"
},
{
    "key": "pagedown",
    "command": "-cursorPageDown",
    "when": "textInputFocus"
},
{
    "key": "alt+pagedown",
    "command": "-scrollPageDown",
    "when": "textInputFocus"
},
// "jump page"
{
    "key": "ctrl+pageup",
    "command": "cursorMove",
    "args": {
        "to": "up",
        "by": "line",
        "value": 10
        },
    "when": "textInputFocus"
},
{
    "key": "ctrl+pagedown",
    "command": "cursorMove",
    "args": {
        "to": "down",
        "by": "line",
        "value": 10
        },
    "when": "textInputFocus"
},
{
    "key": "ctrl+alt+pageup",
    "command": "cursorMove",
    "args": {
        "to": "up",
        "by": "line",
        "value": 30
        },
    "when": "textInputFocus"
},
{
    "key": "ctrl+alt+pagedown",
    "command": "cursorMove",
    "args": {
        "to": "down",
        "by": "line",
        "value": 30
        },
    "when": "textInputFocus"
},
{
    "key": "ctrl+alt+down",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
},
{
    "key": "ctrl+pagedown",
    "command": "-workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
},
{
    "key": "ctrl+alt+up",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
},
{
    "key": "ctrl+pageup",
    "command": "-workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
},
{
    "key": "ctrl+alt+backspace",
    "command": "workbench.action.terminal.kill"
},
]